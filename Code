def get_returns(ticks, years=3):
    start = datetime.today() - timedelta(days=365 * years)
    raw = yf.download(ticks, start=start, auto_adjust=True, progress=False)["Close"]
    # yfinance balance un MultiIndex selon les versions, on aplatit
    if isinstance(raw.columns, pd.MultiIndex):
        raw.columns = raw.columns.get_level_values(0)
    raw = raw[ticks]
    ret = raw.pct_change().dropna()
    return ret


def max_sharpe(ret):
    mu = ret.mean() * 252
    cov = ret.cov() * 252
    n = len(ret.columns)

    def neg_sharpe(w):
        r = np.dot(w, mu)
        v = np.sqrt(w @ cov.values @ w)
        return -(r - rf) / v

    res = minimize(
        neg_sharpe,
        np.ones(n) / n,
        method="SLSQP",
        bounds=[(0, 1)] * n,
        constraints=[{"type": "eq", "fun": lambda w: w.sum() - 1}]
    )
    w = np.clip(res.x, 0, 1)
    w /= w.sum()
    return dict(zip(ret.columns, w))


def min_vol(ret):
    cov = ret.cov() * 252
    n = len(ret.columns)

    def vol(w):
        return np.sqrt(w @ cov.values @ w)

    res = minimize(
        vol,
        np.ones(n) / n,
        method="SLSQP",
        bounds=[(0, 1)] * n,
        constraints=[{"type": "eq", "fun": lambda w: w.sum() - 1}]
    )
    w = np.clip(res.x, 0, 1)
    w /= w.sum()
    return dict(zip(ret.columns, w))


def get_metrics(weights, ret):
    ticks = list(weights.keys())
    w = np.array([weights[k] for k in ticks])
    mu = ret[ticks].mean() * 252
    cov = ret[ticks].cov() * 252
    r = float(np.dot(w, mu))
    v = float(np.sqrt(w @ cov.values @ w))
    sharpe = (r - rf) / v
    return r, v, sharpe


def efficient_frontier(ret, nb_pts=150):
    mu = ret.mean() * 252
    cov = ret.cov() * 252
    n = len(ret.columns)
    targets = np.linspace(mu.min(), mu.max(), nb_pts)
    vols, rets = [], []
    for c in targets:
        res = minimize(
            lambda w: np.sqrt(w @ cov.values @ w),
            np.ones(n) / n,
            method="SLSQP",
            bounds=[(0, 1)] * n,
            constraints=[
                {"type": "eq", "fun": lambda w: w.sum() - 1},
                {"type": "eq", "fun": lambda w, c=c: np.dot(w, mu) - c}
            ]
        )
        if res.success:
            vols.append(res.fun * 100)
            rets.append(c * 100)
    return vols, rets


def read_json(json_str):
    # pd.read_json veut un StringIO en pandas 2.x, pas une string brute
    df = pd.read_json(StringIO(json_str))
    df.index = pd.to_datetime(df.index, unit="ms")
    df = df.sort_index()
    return df


def get_real_weights(ids, vals, opt_weights):
    w = {}
    for i, d in enumerate(ids):
        t = d["ticker"]
        try:
            v = float(vals[i]) / 100 if vals[i] is not None else opt_weights.get(t, 0)
        except Exception:
            v = opt_weights.get(t, 0)
        w[t] = v
    total = sum(w.values())
    if total > 0:
        w = {t: v / total for t, v in w.items()}
    return w


