    try:
        ret = get_returns(tickers, annees)
        opt_w = max_sharpe(ret) if methode == "sharpe" else min_vol(ret)
        msg = html.Div(
            f"✓ Données chargées · {len(ret)} jours · {datetime.now().strftime('%d/%m/%Y %H:%M')}",
