                   "borderRadius": "8px", "fontSize": "13px", "marginBottom": "12px"}
        )
        return ret.to_json(), opt_w, msg
    except Exception as e:
        err = html.Div(
            f"⚠ Erreur : {e}",
            style={"backgroundColor": "#2b0d1f", "color": red, "padding": "8px 16px",
                   "borderRadius": "8px", "fontSize": "13px", "marginBottom": "12px"}
        )
        return None, None, err


