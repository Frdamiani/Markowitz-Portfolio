@app.callback(
    Output("graph-barres", "figure"),
    Output("alerte", "children"),
    Input("btn-calc", "n_clicks"),
    State({"type": "input-poids", "ticker": dash.ALL}, "value"),
    State({"type": "input-poids", "ticker": dash.ALL}, "id"),
    State("store-opt-weights", "data"),
    State("seuil", "value"),
    prevent_initial_call=True
)
def update_chart(n, vals, ids, opt_w, seuil):
    if not opt_w:
        return go.Figure(), []

    thresh = (seuil or 5) / 100
    real_w = get_real_weights(ids, vals, opt_w) if ids else opt_w

    labels = [noms.get(t, t) for t in tickers]
    fig = go.Figure()
    fig.add_bar(
        name="Optimal", x=labels,
        y=[opt_w[t] * 100 for t in tickers],
        marker_color=blue, opacity=0.85
    )
    fig.add_bar(
        name="Réel", x=labels,
        y=[real_w.get(t, 0) * 100 for t in tickers],
        marker_color=green, opacity=0.85
    )
    fig.update_layout(
        barmode="group",
        paper_bgcolor=card, plot_bgcolor=card, font_color=txt,
        margin=dict(l=10, r=10, t=10, b=10),
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
        yaxis=dict(title="%", gridcolor="#2d3047"),
        xaxis=dict(gridcolor="#2d3047")
    )

    drifts = []
    for t in tickers:
        diff = abs(real_w.get(t, 0) - opt_w[t])
        if diff > thresh:
            drifts.append((t, real_w.get(t, 0) * 100, opt_w[t] * 100, diff * 100))

    if drifts:
        lines = []
        for t, rw, ow, d in drifts:
            label = "surpondéré" if rw > ow else "sous-pondéré"
            lines.append(html.Div(f"⚠  {t} — {label} de {d:.1f}pp  (réel {rw:.1f}% / optimal {ow:.1f}%)"))

        banner = html.Div(
            style={"backgroundColor": "#2b1a00", "border": f"1px solid {yellow}",
                   "borderRadius": "10px", "padding": "14px 18px", "marginBottom": "12px"},
            children=[
                html.Div("🔔 Rééquilibrage recommandé",
                         style={"fontWeight": 700, "color": yellow, "marginBottom": "8px", "fontSize": "14px"})
            ] + lines
        )
    else:
        banner = html.Div(
            "✓ Portefeuille aligné",
            style={"backgroundColor": "#0d2b1f", "color": green, "padding": "10px 18px",
                   "borderRadius": "10px", "marginBottom": "12px", "fontSize": "13px"}
        )

    return fig, banner


@app.callback(
    Output("affichage-metriques", "children"),
    Input("store-ret", "data"),
    Input("store-opt-weights", "data"),
    Input("btn-calc", "n_clicks"),
    State({"type": "input-poids", "ticker": dash.ALL}, "value"),
    State({"type": "input-poids", "ticker": dash.ALL}, "id"),
    prevent_initial_call=True
)
def show_metrics(ret_json, opt_w, n, vals, ids):
    if not ret_json or not opt_w:
        return html.P("Chargement...", style={"color": gray})

    ret = read_json(ret_json)
    real_w = get_real_weights(ids, vals, opt_w) if ids else opt_w

    r_opt, v_opt, s_opt = get_metrics(opt_w, ret)
    r_real, v_real, s_real = get_metrics(real_w, ret)

    def bloc(label, v_opt, v_real, fmt, higher_is_better=True):
        delta = v_real - v_opt
        color = green if (delta >= 0) == higher_is_better else red
        return html.Div(
            style={"backgroundColor": bg, "borderRadius": "8px",
                   "padding": "14px 16px", "marginBottom": "10px"},
            children=[
                html.Div(label, style={"fontSize": "12px", "color": gray, "marginBottom": "6px"}),
                html.Div(
                    style={"display": "flex", "gap": "24px"},
                    children=[
                        html.Div([
                            html.Div("Optimal", style={"fontSize": "11px", "color": gray}),
                            html.Div(format(v_opt, fmt),
                                     style={"fontSize": "20px", "fontWeight": 700, "color": blue})
                        ]),
                        html.Div([
                            html.Div("Réel", style={"fontSize": "11px", "color": gray}),
                            html.Div(format(v_real, fmt),
                                     style={"fontSize": "20px", "fontWeight": 700, "color": color})
                        ]),
                        html.Div([
                            html.Div("Écart", style={"fontSize": "11px", "color": gray}),
                            html.Div(("+" if delta >= 0 else "") + format(delta, fmt),
                                     style={"fontSize": "20px", "fontWeight": 700, "color": color})
                        ])
                    ]
                )
            ]
        )

    return [
        bloc("Rendement annualisé", r_opt, r_real, ".1%", True),
        bloc("Volatilité annualisée", v_opt, v_real, ".1%", False),
        bloc("Sharpe", s_opt, s_real, ".2f", True),
    ]


@app.callback(
    Output("graph-front", "figure"),
    Input("store-ret", "data"),
    Input("store-opt-weights", "data")
)
def show_frontier(ret_json, opt_w):
    if not ret_json or not opt_w:
        return go.Figure()

    ret = read_json(ret_json)
    vols, rets = efficient_frontier(ret)
    r_opt, v_opt, _ = get_metrics(opt_w, ret)

    mu = ret.mean() * 252
    vol_ind = ret.std() * np.sqrt(252)

    fig = go.Figure()
    fig.add_scatter(x=vols, y=rets, mode="lines", name="Frontière",
                    line=dict(color=blue, width=2))
    fig.add_scatter(
        x=[v_opt * 100], y=[r_opt * 100],
        mode="markers", name="Optimal",
        marker=dict(color=yellow, size=12, symbol="star")
    )
    for t in tickers:
        if t in mu.index:
            fig.add_scatter(
                x=[vol_ind[t] * 100], y=[mu[t] * 100],
                mode="markers+text", text=[t], textposition="top center",
                marker=dict(size=7, color=gray),
                showlegend=False,
                textfont=dict(size=10, color=gray)
            )
    fig.update_layout(
        paper_bgcolor=card, plot_bgcolor=card, font_color=txt,
        margin=dict(l=10, r=10, t=10, b=10),
        xaxis=dict(title="Vol (%)", gridcolor="#2d3047"),
        yaxis=dict(title="Rendement (%)", gridcolor="#2d3047"),
        legend=dict(orientation="h", yanchor="bottom", y=1.02)
    )
    return fig


@app.callback(
    Output("graph-perf", "figure"),
    Input("store-ret", "data")
)
def show_perf(ret_json):
    if not ret_json:
        return go.Figure()

    ret = read_json(ret_json)
    pal = px.colors.qualitative.Plotly
    fig = go.Figure()
    for i, t in enumerate(tickers):
        if t in ret.columns:
            cum = (1 + ret[t]).cumprod() - 1
            fig.add_scatter(
                x=cum.index, y=cum * 100,
                mode="lines", name=t,
                line=dict(color=pal[i % len(pal)], width=1.5)
            )
    fig.update_layout(
        paper_bgcolor=card, plot_bgcolor=card, font_color=txt,
        margin=dict(l=10, r=10, t=10, b=10),
        xaxis=dict(gridcolor="#2d3047"),
        yaxis=dict(title="Perf cumulée (%)", gridcolor="#2d3047"),
        legend=dict(orientation="h", yanchor="bottom", y=1.02),
        hovermode="x unified"
    )
    return fig


